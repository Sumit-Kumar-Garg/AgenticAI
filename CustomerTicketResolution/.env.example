# Copy to .env and fill in. .env is git-ignored.
LLM_PROVIDER=gemini                 # gemini | groq | openai
GOOGLE_API_KEY=                     # https://aistudio.google.com/apikey (also used for embeddings)
# GEMINI_MODEL=gemini-2.5-flash

# GROQ_API_KEY=                     # https://console.groq.com/keys
# GROQ_MODEL=llama-3.3-70b-versatile

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# WEBHOOK_TOKEN=                    # optional shared secret for /triage and /queue
# EVAL_DELAY=2                      # seconds between eval calls (free-tier rate limits)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
