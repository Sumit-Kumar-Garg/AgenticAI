{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Triage API (app.api)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.api:api", "--reload"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "jinja": true
        },
        {
            "name": "Investigator API (app.main)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.main:app", "--reload"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Run evaluation",
            "type": "debugpy",
            "request": "launch",
            "module": "evals.run_eval",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Build SQLite database",
            "type": "debugpy",
            "request": "launch",
            "module": "app.services.database",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Ingest knowledge base (ChromaDB)",
            "type": "debugpy",
            "request": "launch",
            "module": "app.rag.ingest",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
